{"prompt": "Count rows of input/sales.csv and write output/summary.txt", "inputs": {"input/sales.csv": "a,b\n1,2\n", "input/other.txt": "x\n"}, "output_targets": ["output/summary.txt"], "llm": {"provider": "scripted", "steps": [{"tool": "run_command", "args": {"command": "for i in 1 2 3 4 5; do cat input/sales.csv >/dev/null; sleep 0.1; done; wc -l input/sales.csv"}}, {"tool": "read_file", "args": {"file_path": "input/sales.csv"}}, {"tool": "run_command", "args": {"command": "cat input/other.txt; ls /etc >/dev/null; python3 -c 'print(1)'"}}, {"tool": "write_file", "args": {"file_path": "output/summary.txt", "content": "ok"}}, {"final": "done"}]}, "timeout_s": 120, "condition": "concurrency_B"}